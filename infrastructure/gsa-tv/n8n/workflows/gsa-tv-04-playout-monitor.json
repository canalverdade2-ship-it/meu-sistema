{
  "id": "gsaTvPlayoutMonitor04",
  "name": "GSA TV 04 - Playout Monitor",
  "active": true,
  "settings": {
    "saveManualExecutions": true,
    "executionOrder": "v1",
    "timezone": "America/Sao_Paulo"
  },
  "tags": [
    {
      "name": "gsa-tv"
    },
    {
      "name": "v2-vps"
    }
  ],
  "nodes": [
    {
      "id": "s4",
      "name": "Cron - Every 2 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        240,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "*/2 * * * *"
            }
          ]
        }
      }
    },
    {
      "id": "exec-trigger",
      "name": "Execute - Test or Reuse",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        440
      ],
      "parameters": {
        "inputSource": "passthrough"
      }
    },
    {
      "id": "h4",
      "name": "HTTP - Automation Snapshot",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        460,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "http://172.30.250.1:19202/automation/snapshot",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "c4",
      "name": "Code - Assess Playout",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        300
      ],
      "parameters": {
        "jsCode": "const c=$json.channel||{};const hb=c.last_heartbeat_at?Date.now()-Date.parse(c.last_heartbeat_at):Infinity;const expected=c.desired_state==='running'||c.desired_state==='paused';const healthy=hb<120000&&(!expected||c.signal_state==='sending')&&!c.last_error;return [{json:{healthy,heartbeat_age_ms:hb,status:c.status,desired_state:c.desired_state,signal_state:c.signal_state,last_error:c.last_error||null}}];"
      }
    },
    {
      "id": "i4",
      "name": "IF - Healthy?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        900,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond",
              "leftValue": "={{ $json.healthy }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "n4",
      "name": "No-op - Healthy",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1120,
        180
      ],
      "parameters": {}
    },
    {
      "id": "h42",
      "name": "HTTP - Enqueue Health Check",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1120,
        420
      ],
      "parameters": {
        "method": "POST",
        "url": "http://172.30.250.1:19202/automation/jobs",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"job_type\":\"health_check\",\"payload\":{\"source\":\"n8n-playout-monitor\"}}",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "onError": "continueRegularOutput"
    }
  ],
  "connections": {
    "Cron - Every 2 Minutes": {
      "main": [
        [
          {
            "node": "HTTP - Automation Snapshot",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP - Automation Snapshot": {
      "main": [
        [
          {
            "node": "Code - Assess Playout",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Code - Assess Playout": {
      "main": [
        [
          {
            "node": "IF - Healthy?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "IF - Healthy?": {
      "main": [
        [
          {
            "node": "No-op - Healthy",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "HTTP - Enqueue Health Check",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Execute - Test or Reuse": {
      "main": [
        [
          {
            "node": "HTTP - Automation Snapshot",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
