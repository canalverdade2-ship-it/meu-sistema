{
  "id": "gsaTvRightsWatch06",
  "name": "GSA TV 06 - Rights Watch",
  "active": true,
  "settings": {
    "saveManualExecutions": true,
    "executionOrder": "v1",
    "timezone": "America/Sao_Paulo"
  },
  "tags": [
    {
      "name": "gsa-tv"
    },
    {
      "name": "v2-vps"
    }
  ],
  "nodes": [
    {
      "id": "s6",
      "name": "Cron - Daily 06:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        240,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 6 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "exec-trigger",
      "name": "Execute - Test or Reuse",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        440
      ],
      "parameters": {
        "inputSource": "passthrough"
      }
    },
    {
      "id": "h6",
      "name": "HTTP - Automation Snapshot",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        460,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "http://172.30.250.1:19202/automation/snapshot",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "c6",
      "name": "Code - Rights Report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        300
      ],
      "parameters": {
        "jsCode": "const rows=$json.rights_expiring||[];return [{json:{type:'rights_watch',generated_at:new Date().toISOString(),expiring_count:rows.length,items:rows.slice(0,25).map(x=>({id:x.id,title:x.title,expires_at:x.rights_expires_at}))}}];"
      }
    },
    {
      "id": "h62",
      "name": "HTTP - Save Rights Report",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        900,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "http://172.30.250.1:19202/automation/report",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "h63",
      "name": "HTTP - Validate Schedule",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1120,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "http://172.30.250.1:19202/automation/jobs",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"job_type\":\"validate_schedule\",\"payload\":{\"source\":\"n8n-rights-watch\"}}",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "onError": "continueRegularOutput"
    }
  ],
  "connections": {
    "Cron - Daily 06:00": {
      "main": [
        [
          {
            "node": "HTTP - Automation Snapshot",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP - Automation Snapshot": {
      "main": [
        [
          {
            "node": "Code - Rights Report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Code - Rights Report": {
      "main": [
        [
          {
            "node": "HTTP - Save Rights Report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP - Save Rights Report": {
      "main": [
        [
          {
            "node": "HTTP - Validate Schedule",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Execute - Test or Reuse": {
      "main": [
        [
          {
            "node": "HTTP - Automation Snapshot",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
