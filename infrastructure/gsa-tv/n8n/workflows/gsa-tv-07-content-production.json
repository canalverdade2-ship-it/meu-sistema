{
  "id": "gsaTvAiProduction07",
  "name": "GSA TV 07 - Approved AI Production",
  "active": true,
  "settings": {
    "saveManualExecutions": true,
    "executionOrder": "v1",
    "timezone": "America/Sao_Paulo"
  },
  "tags": [
    {
      "name": "gsa-tv"
    },
    {
      "name": "v2-vps"
    }
  ],
  "nodes": [
    {
      "id": "s7",
      "name": "Cron - Every 10 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        240,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "*/10 * * * *"
            }
          ]
        }
      }
    },
    {
      "id": "exec-trigger",
      "name": "Execute - Test or Reuse",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        440
      ],
      "parameters": {
        "inputSource": "passthrough"
      }
    },
    {
      "id": "h7",
      "name": "HTTP - Automation Snapshot",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        460,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "http://172.30.250.1:19202/automation/snapshot",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "c7",
      "name": "Code - Approved Autonomous Projects",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        300
      ],
      "parameters": {
        "jsCode": "const rows=$json.ai_ready||[];return rows.map(x=>({json:{id:x.id,name:x.name,project_type:x.project_type}}));"
      }
    },
    {
      "id": "h72",
      "name": "HTTP - Queue AI Project",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        900,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "=http://172.30.250.1:19202/automation/ai/projects/{{ $json.id }}/run",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "onError": "continueRegularOutput"
    }
  ],
  "connections": {
    "Cron - Every 10 Minutes": {
      "main": [
        [
          {
            "node": "HTTP - Automation Snapshot",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP - Automation Snapshot": {
      "main": [
        [
          {
            "node": "Code - Approved Autonomous Projects",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Code - Approved Autonomous Projects": {
      "main": [
        [
          {
            "node": "HTTP - Queue AI Project",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Execute - Test or Reuse": {
      "main": [
        [
          {
            "node": "HTTP - Automation Snapshot",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
