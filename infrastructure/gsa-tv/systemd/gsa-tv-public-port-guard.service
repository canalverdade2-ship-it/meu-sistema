[Unit]
Description=GSA TV guard for private Docker service ports
After=docker.service firewalld.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/bash -c 'for p in 5432 5433 5678; do /usr/sbin/iptables -C DOCKER-USER -i enp0s6 -p tcp --dport "$p" -j DROP 2>/dev/null || /usr/sbin/iptables -I DOCKER-USER 1 -i enp0s6 -p tcp --dport "$p" -j DROP; done'
ExecStop=/usr/bin/bash -c 'for p in 5432 5433 5678; do /usr/sbin/iptables -D DOCKER-USER -i enp0s6 -p tcp --dport "$p" -j DROP 2>/dev/null || true; done'

[Install]
WantedBy=multi-user.target
